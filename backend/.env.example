ENVIRONMENT=development

# PostgreSQL connection strings. Use a dedicated least-privilege application role,
# never the postgres superuser, for the running application.
DATABASE_URL=postgresql+asyncpg://finance_app_user:CHANGE_ME@127.0.0.1:5432/finance_app_dev
TEST_DATABASE_URL=postgresql+asyncpg://finance_app_user:CHANGE_ME@127.0.0.1:5432/finance_app_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=5/minute
REFRESH_RATE_LIMIT=60/minute

# Receipt storage/OCR. All optional - omit everything below to use the local
# filesystem for storage and the built-in mock OCR provider (clearly labeled
# as demo mode; never fabricates results). Only set S3_BUCKET/S3_REGION once
# an actual S3-compatible bucket is provisioned; only set OCR_PROVIDER to a
# value other than "mock" once a real OCR provider class is implemented.
RECEIPT_STORAGE_DIR=var/receipts
S3_BUCKET=
S3_REGION=
OCR_PROVIDER=mock

# Financial AI Assistant. Optional - omit ANTHROPIC_API_KEY to use the
# deterministic mock provider (clearly labeled as demo mode; never fabricates
# results). Only set it once a real Anthropic API key is provisioned.
#
# This same key (and AI_MODEL) is also reused by the background AI-assisted
# transaction-categorization classifier (app.ai.classifier) - a separate,
# narrower, one-shot abstraction from the assistant above, never the
# conversational one. Setting this key does NOT by itself turn AI
# categorization on for any user: each user must additionally opt in via
# their own ai_categorization_enabled setting (default false, enforced
# server-side in app.services.sync_service) before a single sync-derived
# transaction is ever sent to it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_RATE_LIMIT=20/minute

# Natural-Language Financial Search
SEARCH_RATE_LIMIT=30/minute

# Automatic transaction sync. Optional - omit to use the deterministic mock
# provider (clearly labeled as demo mode; never fabricates results). There
# is no field here for a UPI PIN, card PIN, ATM PIN, CVV, OTP, banking
# password, or any other payment-authorization credential - this
# integration is permanently read-only and must never collect one.
#
# SYNC_PROVIDER is "mock" (default) or "setu_sandbox". "setu_sandbox"
# selects app.sync.provider.setu_sandbox.SetuSandboxSyncProvider - a
# SANDBOX/UAT-only structural seam (Phase F8) whose operations are not yet
# implemented (see that module's docstring); setting it does not connect to
# any real account and requires none of the SETU_SANDBOX_* values below to
# even be set. Never set SYNC_PROVIDER to anything implying a production
# bank/Account Aggregator integration - none exists in this codebase.
SYNC_PROVIDER=mock
SYNC_LINK_RATE_LIMIT=10/minute
SYNC_TRIGGER_RATE_LIMIT=20/minute

# Setu sandbox Account Aggregator credentials - SANDBOX/UAT ONLY. Only ever
# obtain these from Setu's own sandbox developer portal, never from a
# production Setu account; never place a production Setu credential here or
# anywhere else in this repository. Unused today (SetuSandboxSyncProvider
# makes no real request yet - see app/sync/provider/setu_sandbox.py).
SETU_SANDBOX_BASE_URL=
SETU_SANDBOX_CLIENT_ID=
SETU_SANDBOX_CLIENT_SECRET=
