# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - .env.example is a template with placeholder values only and
# must stay committed (see CLAUDE.md's env-var rules and README.md's setup
# steps, which `cp` it into .env.local); without this negation, the blanket
# .env* pattern above silently also matched .env.example, so it was never
# actually tracked - a fresh clone had no file for that `cp` step to copy.
.env*
!.env.example

# vercel
.vercel

# ad hoc Playwright visual-verification artifacts (screenshots, one-off scripts)
/playwright-artifacts/

# typescript
*.tsbuildinfo
next-env.d.ts
